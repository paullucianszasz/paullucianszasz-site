---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LotusFlower from '../components/LotusFlower.astro';
import '../styles/global.css';
import { seo } from '../data/seo.js';

const { t, active = '', title = '', meta = null, noindex = false } = Astro.props;
const s = seo[t.lang];
const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const darkHeader = ['/', '/en/'].includes(pathname);
const brand = t.lang === 'ro' ? 'Paul Lucian Szasz - Psihoterapeut' : 'Paul Lucian Szasz - Psychotherapist';

// Titlu si descriere pe ruta, din src/data/seo.js; meta (per articol, din frontmatter) are intai.
const page = s.pages[pathname];
const pair = meta || page;
const pageTitle = meta?.title ?? (page ? page.title : (title ? `${title} - ${brand}` : `Dr. ${brand}`));
const description = meta?.desc ?? (page ? page.desc : s.defaultDesc);

const abs = (path) => new URL(path, Astro.site).toString();
const canonical = abs(meta?.canonical || (page ? page.canonical : pathname));
const ogImage = abs(s.ogImage);

// Coduri hreflang doar cu limba: acopera orice vorbitor de romana (nu numai cei din Romania), iar
// Google recomanda codul simplu cand nu exista variante regionale ale aceleasi limbi. x-default ramane romana.
const hreflang = t.lang;
const hreflangOther = t.lang === 'ro' ? 'en' : 'ro';

// JSON-LD: Person (schema.org nu are "Psychologist"), doar datele cunoscute; pentru articole se adauga BlogPosting.
// LocalBusiness (cabinet) insoteste Person pentru rezultatele locale din Romania.
const jsonLd = { '@context': 'https://schema.org', '@type': 'Person', ...s.person };
const businessLd = { '@context': 'https://schema.org', '@type': 'LocalBusiness', ...s.business };
const articleLd = meta?.ld ? { '@context': 'https://schema.org', ...meta.ld } : null;
---
<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {/* Pagina de eroare: fara canonical si fara hreflang (nu este o pagina de indexat) */}
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        {pair && (
          <>
            <link rel="alternate" hreflang={hreflang} href={abs(pair.canonical)} />
            {pair.alt && <link rel="alternate" hreflang={hreflangOther} href={abs(pair.alt)} />}
            <link rel="alternate" hreflang="x-default" href={abs('/')} />
          </>
        )}
      </>
    )}

    <!-- Share / link preview -->
    <meta property="og:type" content={meta ? 'article' : 'profile'} />
    <meta property="og:site_name" content={s.siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={t.lang === 'ro' ? 'ro_RO' : 'en_US'} />
    {meta?.date && <meta property="article:published_time" content={meta.date} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {!noindex && (
      <>
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
        <script type="application/ld+json" set:html={JSON.stringify(businessLd)}></script>
        {articleLd && <script type="application/ld+json" set:html={JSON.stringify(articleLd)}></script>}
      </>
    )}
    <link rel="icon" href="/assets/favicon.png" />
    <link rel="apple-touch-icon" href="/assets/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Source+Serif+4:opsz,wght@8..60,300;8..60,400;8..60,600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="lotus-mark" aria-hidden="true"><LotusFlower /></div>
    <Header t={t} active={active} dark={darkHeader} />
    <main>
      <slot />
    </main>
    <Footer t={t} active={active} />

    <div class="scroll-top" title="Scroll to top">↑</div>

    <script>
      // Header dropdowns: open on click/tap (hover still works on desktop)
      const setOpen = (li, open) => {
        if (open) {
          li.classList.add('open');
        } else {
          li.classList.remove('open');
          li.querySelectorAll('.open').forEach((d) => d.classList.remove('open'));
        }
        const toggle = li.querySelector(':scope > .nav-toggle');
        if (toggle) toggle.setAttribute('aria-expanded', String(open));
      };

      const closeAllNav = () =>
        document.querySelectorAll('.nav-item.open, .nav-sub-item.open').forEach((li) => setOpen(li, false));

      document.querySelectorAll('.nav-toggle').forEach((btn) => {
        btn.addEventListener('click', () => {
          const li = btn.closest('li');
          const wasOpen = li.classList.contains('open');
          // Close only the entries at the same level, so a nested group keeps its parent open.
          li.parentElement.querySelectorAll(':scope > li.open').forEach((s) => setOpen(s, false));
          setOpen(li, !wasOpen);
        });
      });

      document.addEventListener('click', (e) => {
        if (!e.target.closest('.nav-item')) closeAllNav();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeAllNav();
      });

      // FAQ accordion
      document.querySelectorAll('.faq-item .q').forEach((q) => {
        q.addEventListener('click', () => q.closest('.faq-item').classList.toggle('open'));
      });

      // Scroll to top
      document.querySelector('.scroll-top').addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
    </script>
  </body>
</html>
