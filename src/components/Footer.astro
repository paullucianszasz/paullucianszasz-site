---
import WhatsAppIcon from './WhatsAppIcon.astro';

const { t, active = '' } = Astro.props;
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <img src="/assets/logo-sc-prim-white.png" alt={`Dr. Paul Lucian Szasz - ${t.hero.role}`} />
      <nav class="footer-nav">
        {t.footerNav.map((i) => <a href={i.href} class={i.label === active ? 'active' : ''}>{i.label}</a>)}
      </nav>
    </div>
    <div class="footer-bottom">
      <div class="addr">{t.footer.address}</div>
      <div class="contacts">
        <a href={t.cta.href}>{t.footer.phone}</a>
        <a class="wa-pill" href={t.whatsapp.href} aria-label={`WhatsApp — ${t.footer.phone}`} target="_blank" rel="noopener">
          <WhatsAppIcon />
          <span class="wa-label">{t.whatsapp.label}</span>
        </a>
        <div>{t.footer.emails.map((e) => <a href={`mailto:${e}`}>{e}</a>)}</div>
      </div>
    </div>
  </div>
</footer>
