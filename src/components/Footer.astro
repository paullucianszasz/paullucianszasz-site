---
import WhatsAppIcon from './WhatsAppIcon.astro';
import SocialIcon from './SocialIcon.astro';

const { t, active = '' } = Astro.props;
const social = (t.footer.social || []).filter((s) => s.url);
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <img src="/assets/logo-sc-prim-white.png" alt={`Dr. Paul Lucian Szasz - ${t.hero.role}`} />
      <nav class="footer-nav">
        {t.footerNav.map((i) => <a href={i.href} class={i.label === active ? 'active' : ''}>{i.label}</a>)}
      </nav>
    </div>
    <div class="footer-bottom">
      <div class="addr">{t.footer.address}{t.footer.note ? ` (${t.footer.note})` : ''}</div>
      <div class="contacts">
        <a href={t.cta.href}>{t.footer.phone}</a>
        <a class="wa-pill" href={t.whatsapp.href} aria-label={`WhatsApp — ${t.footer.phone}`} target="_blank" rel="noopener">
          <WhatsAppIcon />
          <span class="wa-label">{t.whatsapp.label}</span>
        </a>
        <div>{t.footer.emails.map((e) => <a href={`mailto:${e}`}>{e}</a>)}</div>
      </div>
    </div>
    {social.length > 0 && (
      <div class="footer-social">
        {social.map((s) => (
          <a href={s.url} aria-label={`${s.name} — Dr. Paul Lucian Szasz`} target="_blank" rel="noopener me">
            <SocialIcon name={s.name} />
            <span>{s.name}</span>
          </a>
        ))}
      </div>
    )}
  </div>
</footer>
