---
const { t, active = '', dark = false } = Astro.props;
const hasSub = (item) => Array.isArray(item.children) && item.children.length > 0;
const subId = (label) => `nav-${label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const navLabel = t.lang === 'ro' ? 'Navigare' : 'Navigation';
const logo = dark ? '/assets/logo-sc-prim-white.png' : '/assets/logo-sc-prim-black-1.png';
const waIcon = 'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z';
---
<header class="site-header">
  <div class={"header-main" + (dark ? ' dark' : '')}>
    <a class="header-logo" href={t.home}>
      <img src={logo} alt={`Dr. Paul Lucian Szasz - ${t.hero.role}`} />
    </a>
    <nav aria-label={navLabel}>
      <ul class="header-nav">
        {t.nav.map((item) => (
          <li class={"nav-item" + (item.label === active ? ' active' : '') + (hasSub(item) ? ' has-sub' : '')}>
            {hasSub(item) ? (
              <button class="nav-link nav-toggle" type="button" aria-expanded="false" aria-controls={subId(item.label)}>
                {item.label}
              </button>
            ) : (
              <a class="nav-link" href={item.href}>{item.label}</a>
            )}
            {hasSub(item) && (
              <ul class="nav-sub" id={subId(item.label)}>
                {item.children.map((c) => (
                  <li class={"nav-sub-item" + (hasSub(c) ? ' has-sub' : '')}>
                    {hasSub(c) ? (
                      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls={subId(c.label)}>
                        {c.label}
                      </button>
                    ) : (
                      <a href={c.href}>{c.label}</a>
                    )}
                    {hasSub(c) && (
                      <ul class="nav-sub-inline" id={subId(c.label)}>
                        {c.children.map((cc) => <li><a href={cc.href}>{cc.label}</a></li>)}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
        <li class="nav-cta-item">
          <a class="header-cta" href={t.cta.href} aria-label={`${t.cta.label} — ${t.footer.phone}`}>
            <span class="cta-label">{t.cta.label}</span>
            <span class="cta-phone">{t.footer.phone}</span>
          </a>
        </li>
        <li class="nav-wa-item">
          <a class="header-wa" href={t.whatsapp.href} aria-label={`WhatsApp — ${t.footer.phone}`} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={waIcon} /></svg>
            <span class="wa-label">{t.whatsapp.label}</span>
          </a>
        </li>
      </ul>
    </nav>
    <a class="lang-switch" href={t.otherLang.href}>
      <img src={t.lang === 'ro' ? '/assets/flag-en.png' : '/assets/flag-ro.png'} alt={t.otherLang.label} /> {t.otherLang.label}
    </a>
  </div>
</header>
