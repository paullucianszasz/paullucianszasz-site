---
const { t, items = t.faq, heading = t.labels.faq } = Astro.props;
---
<section class="faq">
  <div class="glow g1" aria-hidden="true"></div>
  <div class="glow g2" aria-hidden="true"></div>
  <div class="container">
    <h2>{heading}</h2>
    {items.map((f) => (
      <div class="faq-item">
        <div class="q"><span class="marker">▸</span><span>{f.q}</span></div>
        <div class="a">
          {f.a.map((p) => <p>{p}</p>)}
          {f.groups && f.groups.map((g) => (
            <div class="group">
              <p class="group-label">{g.label}</p>
              <ul>{g.items.map((l) => <li>{l}</li>)}</ul>
            </div>
          ))}
          {f.list && <ul>{f.list.map((l) => <li>{l}</li>)}</ul>}
        </div>
      </div>
    ))}
  </div>
</section>
