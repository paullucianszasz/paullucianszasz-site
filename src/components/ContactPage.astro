---
import Base from '../layouts/Base.astro';
import Faq from './Faq.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';

const { t, page } = Astro.props;
const active = 'Contact';
const labels = page.labels;
const form = page.form;
const mapTitle = t.footer.address;
const mapSrc = `https://maps.google.com/maps?q=${encodeURIComponent(t.footer.address)}&t=m&z=10&output=embed&iwloc=near`;
---
<Base t={t} active={active} title={page.title}>
  <section class="page contact-page">
    <div class="container">
      <h1>{page.title}</h1>
      <div class="contact-grid">
        <div class="contact-col">
          <h2>{labels.phone}</h2>
          <p><a href={t.cta.href}>{t.footer.phone}</a></p>
          <p class="wa-line">
            {labels.waBefore}&nbsp;
            <a class="wa-pill" href={t.whatsapp.href} aria-label={`WhatsApp — ${t.footer.phone}`} target="_blank" rel="noopener">
              <WhatsAppIcon />
              <span class="wa-label">{t.whatsapp.label}</span>
            </a>
          </p>
          <h2>{labels.email}</h2>
          <ul class="email-list">
            {t.footer.emails.map((e) => <li><a href={`mailto:${e}`}>{e}</a></li>)}
          </ul>
          <h2>{labels.hours}</h2>
          <p>{page.hours}</p>
          <h2>{labels.location}</h2>
          <p>{t.footer.address}</p>
          <div class="contact-map">
            <iframe loading="lazy" src={mapSrc} title={mapTitle} aria-label={mapTitle} referrerpolicy="no-referrer-when-downgrade"></iframe>
          </div>
        </div>
        <div class="contact-col">
          <form class="contact-form form-style-7" data-mailto={t.footer.emails[0]}>
            <p class="field icon-name">
              <input size="40" type="text" name="name" data-label={form.body.name} placeholder={form.name} aria-required="true" required />
              <span class="line"></span>
            </p>
            <p class="field icon-phone">
              <input size="40" type="tel" name="phone" data-label={form.body.phone} placeholder={form.phone} aria-required="true" required />
              <span class="line"></span>
            </p>
            <p class="field icon-email">
              <input size="40" type="email" name="email" data-label={form.body.email} placeholder={form.email} aria-required="true" required />
              <span class="line"></span>
            </p>
            <p class="field icon-subject">
              <input size="40" type="text" name="subject" data-label={form.body.subject} placeholder={form.subject} aria-required="true" required />
              <span class="line"></span>
            </p>
            <p class="field icon-textarea">
              <textarea cols="40" rows="10" name="message" data-label={form.body.message} placeholder={form.message} aria-required="true" required></textarea>
              <span class="line"></span>
            </p>
            <p class="consent">
              <input type="checkbox" id="form-consent" name="consent" value="confirmed" required />
              <label for="form-consent">{form.consent}</label>
            </p>
            <p>
              <span class="field-btn">
                <input class="wpcf7-submit" type="submit" value={form.submit} />
                <span class="submit-style-in"></span>
              </span>
            </p>
            <p class="form-note"><a href="#privacy">{page.formNote}</a></p>
            <p class="form-note">{form.mailtoNote} <a href={`mailto:${t.footer.emails[0]}`}>{t.footer.emails[0]}</a></p>
          </form>
        </div>
      </div>

      <div class="contact-block">
        <h3>{labels.booking}</h3>
        {page.booking.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <Faq t={t} items={page.faq} heading={page.faqHeading} />

  <section class="page">
    <div class="container privacy" id="privacy">
      <h3>{page.privacyHeading}</h3>
      {page.privacy.map((p) => <p>{p}</p>)}
      <ul>
        {page.rights.map((r) => <li>{r}</li>)}
      </ul>
      <p><a href={`mailto:${t.footer.emails[0]}`}>{t.footer.emails[0]}</a></p>
    </div>
  </section>
</Base>

<script>
  // Formularul nu trimite nica in afara site-ului: deschide programul de email al vizitatorului.
  const contactForm = document.querySelector('form.contact-form[data-mailto]');
  if (contactForm) {
    contactForm.addEventListener('submit', (event) => {
      event.preventDefault();
      const rows = [...contactForm.querySelectorAll('[data-label]')].map((el) => `${el.dataset.label}: ${el.value.trim()}`);
      const subject = contactForm.querySelector('[name="subject"]').value.trim();
      const href = `mailto:${contactForm.dataset.mailto}?subject=${encodeURIComponent(subject || 'Contact')}&body=${encodeURIComponent(rows.join('\n'))}`;
      window.location.href = href;
    });
  }
</script>
