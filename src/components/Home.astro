---
const { t } = Astro.props;
---
<section class="hero">
  <div class="container">
    <h1>{t.hero.title1} <span class="typed-word">{t.hero.typed}</span></h1>
    <p>{t.hero.text}</p>
    <p>{t.hero.help}</p>
    <div class="author">
      {t.hero.author}
      <small>{t.hero.role}</small>
    </div>
  </div>
</section>

{/* spatiu rezervat pentru sectiunea noua (cardurile de servicii si F.A.Q. au fost scoase de pe prima pagina) */}
