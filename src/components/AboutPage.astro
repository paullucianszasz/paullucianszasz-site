---
import Base from '../layouts/Base.astro';

const { t, about } = Astro.props;
---
<Base t={t} title={about.title} active={t.lang === 'ro' ? 'Despre mine' : 'About me'}>
  <section class="page">
    <div class="container">
      <h1>{about.title}</h1>
      <div class="about-grid">
        <div class="about-photo">
          <img src={about.photo} alt="Dr. Paul Lucian Szasz" />
        </div>
        <div class="about-content">
          {(about.paragraphs || []).map((p) => <p>{p}</p>)}
          {about.illustration && (
            <figure class="about-figure">
              <img src={about.illustration.src} alt={about.illustration.alt} width="1200" height="655" loading="lazy" />
            </figure>
          )}
          <div class="timeline">
            {about.sections.map((sec) => (
              <div>
                <h3>{sec.heading}</h3>
                {(sec.paragraphs || []).map((p) => <p>{p}</p>)}
                {(sec.blocks || [{ items: sec.items, link: sec.link }]).map((block) => (
                  block.items && block.items.length > 0 && (
                    <div class="tl-block">
                      {block.subheading && <h4>{block.subheading}</h4>}
                      {block.items.every((i) => typeof i === 'string' || i.text) ? (
                        <ul>
                          {block.items.map((i) => (
                            <li>
                              {i.text
                                ? i.href
                                  ? <a href={i.href} target="_blank" rel="noopener">{i.text}</a>
                                  : i.text
                                : i}
                            </li>
                          ))}
                        </ul>
                      ) : (
                        block.items.map((i) => (
                          <div class="tl-item">
                            <div class="year">{i.year}</div>
                            <div class="tl-body">
                              <div class="role">{i.role}</div>
                              <div>{i.detail}</div>
                              {i.thesis && (
                                <div class="thesis">{t.lang === 'ro' ? 'Titlul tezei' : 'Thesis title'}: {i.thesis}</div>
                              )}
                              {i.summary && (
                                Array.isArray(i.summary)
                                  ? i.summary.map((p) => <p class="thesis-summary">{p}</p>)
                                  : <p class="thesis-summary">{i.summary}</p>
                              )}
                            </div>
                          </div>
                        ))
                      )}
                      {block.link ? <p class="section-link"><a href={block.link.href}>{block.link.label}</a></p> : null}
                    </div>
                  )
                ))}
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
