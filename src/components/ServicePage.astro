---
import Base from '../layouts/Base.astro';

const { t, service } = Astro.props;

// Astreiskurile din copia furnizata devin bold; la listele cu lead: si primul segment este afisat aldinat (bloc cu lead: true).
const runs = (s) => s.split(/\*\*([^*]+)\*\*/g).map((v, i) => ({ b: i % 2 === 1, v }));

const listRuns = (s, boldLead) => {
  const r = runs(s);
  if (boldLead && !r[0].b) {
    const i = r[0].v.indexOf(': ');
    if (i > 0) return [{ b: true, v: r[0].v.slice(0, i) }, { b: false, v: r[0].v.slice(i) }, ...r.slice(1)];
  }
  return r;
};
---
<Base t={t} title={service.title} active={t.lang === 'ro' ? 'Psihoterapie' : 'Psychotherapy'}>
  <section class="page">
    <div class="container">
      <h1>{service.title}</h1>
      {service.blocks.map((b, i) => (
        b.t === 'p' ? <p>{runs(b.v).map((r) => (r.b ? <strong>{r.v}</strong> : r.v))}</p> :
        b.t === 'quote' ? <blockquote>{runs(b.v).map((r) => (r.b ? <strong>{r.v}</strong> : r.v))}</blockquote> :
        b.t === 'img' ? <figure class="page-figure"><img src={b.src} alt={b.alt} width="1200" height="655" loading={i === 0 ? 'eager' : 'lazy'} /></figure> :
        b.t === 'h3' ? <h3>{b.v}</h3> :
        b.t === 'h4' ? <h4>{b.v}</h4> :
        b.t === 'ul' ? (
          <ul>{b.v.map((li) => <li>{listRuns(li, b.lead).map((r) => (r.b ? <strong>{r.v}</strong> : r.v))}</li>)}</ul>
        ) :
        b.t === 'ol' ? (
          <ol>{b.v.map((li) => <li>{listRuns(li, b.lead).map((r) => (r.b ? <strong>{r.v}</strong> : r.v))}</li>)}</ol>
        ) :
        b.t === 'table' ? (
          <div class="table-wrap">
            <table>
              <thead>
                <tr>{b.head.map((h) => <th>{h}</th>)}</tr>
              </thead>
              <tbody>
                {b.rows.map((row) => (
                  <tr>
                    <th scope="row">{row[0]}</th>
                    {row.slice(1).map((c) => <td>{c}</td>)}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : null
      ))}
    </div>
  </section>
</Base>
